rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(code) {
      return exists(/databases/$(db)/documents/rooms/$(code)/players/$(request.auth.uid));
    }
    function isHost(code) {
      return get(/databases/$(db)/documents/rooms/$(code)).data.hostUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
    }

    // Community Deck (LEARN-5, LEARN-6)
    match /community/deck/{id} {
      allow read: if signedIn();
      allow write: if false; // Server-only Admin SDK
    }

    // Learning Candidate Collections (LEARN-2, LEARN-7)
    match /learning/{collection}/{docId} {
      allow read, write: if false; // Server-only Admin SDK
    }

    match /rooms/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid;
      allow update: if signedIn() && (isHost(code) || isMember(code));

      match /players/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn() && (request.auth.uid == uid || isHost(code));
        allow delete: if signedIn() && (request.auth.uid == uid || isHost(code));
      }

      match /entries/{id} {
        allow read: if signedIn() && isMember(code);
        allow write: if false; // Server only
      }

      match /turns/{turnId} {
        allow read: if signedIn() && isMember(code);
        allow write: if signedIn() && isHost(code);

        match /votes/{uid} {
          allow read: if signedIn() && isMember(code);
          allow write: if signedIn() && isMember(code) && request.auth.uid == uid;
        }

        // 1-Tap Voter Chit Ratings (LEARN-4) - One rating per voter per turn
        match /ratings/{uid} {
          allow read: if signedIn() && isMember(code);
          allow create, update: if signedIn() && isMember(code) && request.auth.uid == uid;
        }

        // Optional Owl Roast Takes (LEARN-7)
        match /takes/{takeId} {
          allow read: if signedIn() && isMember(code);
          allow create: if signedIn() && isMember(code) && request.resource.data.authorUid == request.auth.uid;
        }
      }
    }
  }
}
