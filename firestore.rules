rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(code) {
      return exists(/databases/$(db)/documents/rooms/$(code)/players/$(request.auth.uid));
    }
    function isHost(code) {
      return get(/databases/$(db)/documents/rooms/$(code)).data.hostUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
    }

    match /rooms/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid;
      allow update: if signedIn() && (isHost(code) || isMember(code));

      match /players/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn() && (request.auth.uid == uid || isHost(code));
        allow delete: if signedIn() && (request.auth.uid == uid || isHost(code));
      }

      match /entries/{id} {
        allow read: if signedIn() && isMember(code);
        allow write: if false; // server only
      }

      match /turns/{turnId} {
        allow read: if signedIn() && isMember(code);
        allow write: if signedIn() && isHost(code);

        match /votes/{uid} {
          allow read: if signedIn() && isMember(code);
          allow write: if signedIn() && isMember(code) && request.auth.uid == uid;
        }
      }
    }
  }
}
